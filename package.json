{
  "name": "kkachi",
  "version": "1.0.1",
  "description": "까치 (Kkachi) - IMAP/POP3 순차 이메일 모니터링 및 자동 번역 데스크톱 앱",
  "main": "dist/main/index.cjs",
  "author": "Kkachi",
  "license": "MIT",
  "scripts": {
    "generate:icons": "node scripts/generate-icons.mjs",
    "build:main": "esbuild src/main/index.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/main/index.cjs && esbuild src/preload/index.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/preload/index.cjs",
    "build:renderer": "vite build",
    "build": "npm run generate:icons && npm run build:main && npm run build:renderer",
    "dev": "node scripts/dev.mjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dist:mac": "npm run build && electron-builder --mac --arm64 --x64",
    "dist:mac:arm64": "npm run build && electron-builder --mac --arm64",
    "dist:mac:x64": "npm run build && electron-builder --mac --x64",
    "dist:win": "npm run build && electron-builder --win --x64",
    "dist:all": "npm run build && electron-builder --mac --win --arm64 --x64"
  },
  "dependencies": {
    "dom-serializer": "^2.0.0",
    "domhandler": "^5.0.3",
    "dompurify": "^3.2.4",
    "htmlparser2": "^10.1.0",
    "imapflow": "^1.0.171",
    "mailparser": "^3.7.2",
    "nodemailer": "^6.9.16"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.13.0",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.0",
    "png2icons": "^2.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
